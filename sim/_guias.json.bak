 {
  "tx": "F-28",
  "titulo": "Contabilización de pagos recibidos",
  "sub": "Pago de factura · cheque · pago parcial",
  "modulo": "FI",
  "pasos": [
   {
    "g": "1 · Escenario"
   },
   {
    "screen": "easy",
    "target": "tcode",
    "h": "Ingresar a <b>F-28</b>.",
    "d": "Tres escenarios: PAGO CLIENTE (transferencia) · CHEQUE CLIENTE (uno o más cheques) · ABONO CLIENTE (pago parcial que deja saldo pendiente).",
    "set": {
     "tcode": "F-28"
    }
   },
   {
    "g": "2 · Datos de cabecera"
   },
   {
    "screen": "f53cab",
    "target": "clasedoc",

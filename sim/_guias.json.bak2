    "set": {}
   },
   {
    "screen": "migo",
    "target": "refdoc",
    "h": "Referencia <b>Pedido</b> e ingresar el número de OC.",
    "d": "Al presionar Enter el sistema carga las <b>posiciones abiertas</b> del pedido. Si no se conoce el número: ME2M por material, ME2L por proveedor, ME2N por número o ME2K por centro de costo.",
    "set": {
     "referencia": "R01 Pedido",
     "refdoc": "4500000211",
     "ejercicio": "2026",
     "filas": [

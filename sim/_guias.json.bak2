  "pdf": "Manuales/Manual de Usuario-Registro de Entrada de Mercancías (MIGO).pdf",
  "pasos": [
   {
    "g": "1 · Regla de negocio"
   },
   {
    "screen": "easy",
    "target": "tcode",
    "h": "La entrada sólo se registra cuando el material <b>ingresó físicamente</b>.",
    "d": "Así el inventario y la contabilidad reflejan la realidad operativa. ⚠️ Si una entrega llega parcializada en varios días, se hace <b>una EM por cada día</b> de recepción física, y cada una genera su propio Documento de Material.",
    "crit": 1,
    "set": {
     "tcode": "MIGO"
    }
   },
   {
    "g": "2 · Acceso y referencia"
   },
   {
    "screen": "migo",
    "target": "accion",
    "h": "Configurar la operación: <b>Entrada de mercancías</b>.",
    "d": "Primer desplegable, arriba a la izquierda.",
